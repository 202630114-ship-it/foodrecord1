                            <span class="w-3.5 h-3.5 rounded-full bg-emerald-500"></span> Emerald
                        </button>
                        <button onclick="setTheme('blue')" class="w-full text-left px-3 py-2 text-sm rounded-lg hover:bg-gray-800 flex items-center gap-2.5">
