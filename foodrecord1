    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
        
        <!-- Hero Section -->
        <section class="text-center space-y-4 max-w-2xl mx-auto pt-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold theme-light-bg theme-text border theme-border">
                <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                <span id="badgeText">식자재 유통기한 스마트 기록 관리</span>
            </span>
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white" id="heroTitle">
                식재료 관리부터 AI 레시피 연동까지
            </h1>
            <p class="text-gray-400 text-sm sm:text-base leading-relaxed" id="heroSubtitle">
                유통기한 입력 한 번으로 알림부터 레시피 추천까지 간편하게 받아보세요.
            </p>
        </section>

        <!-- STEP 1 ~ 3 Process Section -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Step 1 -->
            <div class="bg-gray-900 border border-gray-800/80 rounded-2xl p-6 relative overflow-hidden hover:border-gray-700 transition-all">
                <div class="w-10 h-10 rounded-xl theme-light-bg flex items-center justify-center mb-4">
                    <i data-lucide="calendar-plus" class="w-5 h-5 theme-text"></i>
                </div>
                <div class="text-xs font-semibold theme-text uppercase tracking-wider mb-1">STEP 1</div>
                <h3 class="text-lg font-bold text-white mb-2" id="step1Title">유통기한 입력</h3>
                <p class="text-gray-400 text-sm" id="step1Desc">구매한 식재료와 유통기한을 간편하게 기록합니다.</p>
            </div>

            <!-- Step 2 -->
            <div class="bg-gray-900 border border-gray-800/80 rounded-2xl p-6 relative overflow-hidden hover:border-gray-700 transition-all">
                <div class="w-10 h-10 rounded-xl theme-light-bg flex items-center justify-center mb-4">
                    <i data-lucide="bell" class="w-5 h-5 theme-text"></i>
                </div>
                <div class="text-xs font-semibold theme-text uppercase tracking-wider mb-1">STEP 2</div>
                <h3 class="text-lg font-bold text-white mb-2" id="step2Title">임박 알림 받기</h3>
                <p class="text-gray-400 text-sm" id="step2Desc">유통기한이 다가오면 놓치지 않게 미리 알려줍니다.</p>
            </div>

            <!-- Step 3 -->
            <div class="bg-gray-900 border border-gray-800/80 rounded-2xl p-6 relative overflow-hidden hover:border-gray-700 transition-all">
                <div class="w-10 h-10 rounded-xl theme-light-bg flex items-center justify-center mb-4">
                    <i data-lucide="chef-hat" class="w-5 h-5 theme-text"></i>
                </div>
                <div class="text-xs font-semibold theme-text uppercase tracking-wider mb-1">STEP 3</div>
                <h3 class="text-lg font-bold text-white mb-2" id="step3Title">AI 레시피 추천</h3>
                <p class="text-gray-400 text-sm" id="step3Desc">보관 중인 식재료로 만들 수 있는 요리를 추천받습니다.</p>
            </div>
        </section>

        <!-- Interactive Simulator Section -->
        <section class="bg-gray-900/60 border border-gray-800 rounded-3xl p-6 sm:p-8 space-y-6">
            <div class="flex items-center justify-between border-b border-gray-800 pb-4">
                <div>
                    <h2 class="text-xl font-bold text-white flex items-center gap-2" id="simTitle">
                        <i data-lucide="play-circle" class="w-5 h-5 theme-text"></i>
                        체험해보기: 식재료 바로 등록
                    </h2>
                    <p class="text-xs text-gray-400 mt-1" id="simSub">직접 식재료와 유통기한을 선택해서 추가해 보세요.</p>
                </div>
            </div>

            <!-- Form -->
            <form id="addFoodForm" onsubmit="handleAddFood(event)" class="grid grid-cols-1 sm:grid-cols-12 gap-3">
                <div class="sm:col-span-5">
                    <input type="text" id="foodName" placeholder="식재료명 (예: 우유, 두부)" required
                        class="w-full bg-gray-950 border border-gray-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-emerald-500 transition-all placeholder-gray-500">
                </div>
                <div class="sm:col-span-5">
                    <input type="date" id="expiryDate" required
                        class="w-full bg-gray-950 border border-gray-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-emerald-500 transition-all">
                </div>
                <div class="sm:col-span-2">
                    <button type="submit" id="addBtn"
                        class="w-full h-full theme-bg theme-bg-hover text-white font-semibold py-3 px-4 rounded-xl text-sm flex items-center justify-center gap-1.5 transition-all shadow-lg">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        <span id="addBtnText">등록</span>
                    </button>
                </div>
            </form>

            <!-- Food List -->
            <div class="space-y-3 pt-2">
                <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider" id="listHeader">보관 중인 식재료 목록</h4>
                <div id="foodList" class="space-y-3">
                    <!-- Dynamic Items render here -->
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-900 bg-gray-950 py-8 text-center text-xs text-gray-500">
        <p>© 2026 FOODRECORD. All rights reserved.</p>
    </footer>

