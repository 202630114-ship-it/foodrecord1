                        <button onclick="changeLanguage('pt')" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-800 flex items-center gap-2">🇵🇹 Português</button>
                    </div>
                </div>

                <!-- Theme Selector -->
                <div class="relative">
                    <button id="themeBtn" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gray-900 border border-gray-800 hover:border-gray-700 text-sm font-medium transition-all text-gray-300">
                        <i data-lucide="palette" class="w-4 h-4 theme-text"></i>
                        <span>🎨 Theme</span>
                    </button>
                    <div id="themeDropdown" class="hidden absolute right-0 mt-2 w-44 bg-gray-900 border border-gray-800 rounded-xl shadow-2xl p-2 z-50">
