                aiPrefix: "Gợi ý AI: ",
                aiSuffix: " công thức nấu ăn & mẹo bảo quản",
                dDayTag: "ngày còn lại",
                todayTag: "Hết hạn hôm nay",
                expiredTag: "Đã hết hạn"
            },
            ru: {
                badge: "Умный учет сроков годности",
                title: "От учета продуктов до ИИ-рецептов",
                subtitle: "Записывайте сроки годности и получайте уведомления и рецепты от ИИ.",
                step1Title: "Ввод срока",
                step1Desc: "Легко записывайте продукты и их сроки годности.",
                step2Title: "Уведомления",
                step2Desc: "Получайте предупреждения до истечения срока.",
                step3Title: "ИИ-Рецепты",
                step3Desc: "Ищите рецепты из имеющихся продуктов.",
                simTitle: "Попробовать: Добавить продукт",
                simSub: "Выберите продукт и дату для проверки.",
                inputPlaceholder: "Продукт (напр. Молоко, Тофу)",
                addBtn: "Добавить",
                listHeader: "Список продуктов",
                aiPrefix: "ИИ-Рецепт: ",
                aiSuffix: " идеи для готовки и советы по хранению",
                dDayTag: "дн. осталось",
                todayTag: "Истекает сегодня",
                expiredTag: "Истек"
            },
            pt: {
                badge: "Controle Inteligente de Validade",
                title: "Da Gestão de Alimentos a Receitas com IA",
                subtitle: "Registre a validade e receba alertas e sugestões de receitas com IA.",
                step1Title: "Inserir Validade",
                step1Desc: "Registre facilmente seus alimentos e datas.",
                step2Title: "Alertas de Validade",
                step2Desc: "Receba avisos antes que os alimentos vençam.",
                step3Title: "Receitas com IA",
                step3Desc: "Descubra receitas com os ingredientes que possui.",
                simTitle: "Experimente: Adicionar Alimento",
                simSub: "Selecione um alimento e data para testar.",
                inputPlaceholder: "Ingrediente (ex. Leite, Tofu)",
                addBtn: "Adicionar",
                listHeader: "Lista de Alimentos",
                aiPrefix: "Receita IA: ",
                aiSuffix: " ideias de culinária e dicas de conservação",
                dDayTag: "dias restantes",
                todayTag: "Vence hoje",
                expiredTag: "Vencido"
            }
        };

        let currentLang = 'ko';

        // --- 2. Initial Sample Items ---
        let foodItems = [
            { id: 1, name: '우유 (Milk)', date: getFutureDate(3) },
            { id: 2, name: '계란 (Eggs)', date: getFutureDate(7) }
        ];

        function getFutureDate(daysToAdd) {
            const date = new Date();
            date.setDate(date.getDate() + daysToAdd);
            return date.toISOString().split('T')[0];
        }

        // Initialize Default Date to Today in Date Input
        document.getElementById('expiryDate').value = getFutureDate(5);

        // --- 3. Language & Theme Handlers ---
        document.getElementById('langBtn').addEventListener('click', () => {
            document.getElementById('langDropdown').classList.toggle('hidden');
            document.getElementById('themeDropdown').classList.add('hidden');
        });

        document.getElementById('themeBtn').addEventListener('click', () => {
            document.getElementById('themeDropdown').classList.toggle('hidden');
            document.getElementById('langDropdown').classList.add('hidden');
        });

        // Close Dropdowns on Click Outside
        window.addEventListener('click', (e) => {
            if (!e.target.closest('#langBtn') && !e.target.closest('#langDropdown')) {
                document.getElementById('langDropdown').classList.add('hidden');
            }
            if (!e.target.closest('#themeBtn') && !e.target.closest('#themeDropdown')) {
                document.getElementById('themeDropdown').classList.add('hidden');
            }
        });

        function changeLanguage(lang) {
            currentLang = lang;
            const text = i18n[lang];

            document.getElementById('badgeText').innerText = text.badge;
            document.getElementById('heroTitle').innerText = text.title;
            document.getElementById('heroSubtitle').innerText = text.subtitle;
            document.getElementById('step1Title').innerText = text.step1Title;
            document.getElementById('step1Desc').innerText = text.step1Desc;
            document.getElementById('step2Title').innerText = text.step2Title;
            document.getElementById('step2Desc').innerText = text.step2Desc;
            document.getElementById('step3Title').innerText = text.step3Title;
            document.getElementById('step3Desc').innerText = text.step3Desc;
            document.getElementById('simTitle').innerHTML = `<i data-lucide="play-circle" class="w-5 h-5 theme-text"></i> ${text.simTitle}`;
            document.getElementById('simSub').innerText = text.simSub;
            document.getElementById('foodName').placeholder = text.inputPlaceholder;
            document.getElementById('addBtnText').innerText = text.addBtn;
            document.getElementById('listHeader').innerText = text.listHeader;

            document.getElementById('langDropdown').classList.add('hidden');
            renderFoodList();
            lucide.createIcons();
        }

        function setTheme(theme) {
            const root = document.documentElement;
            if (theme === 'emerald') {
                root.style.setProperty('--theme-color', '#10b981');
                root.style.setProperty('--theme-hover', '#059669');
                root.style.setProperty('--theme-light', 'rgba(16, 185, 129, 0.15)');
                root.style.setProperty('--theme-border', 'rgba(16, 185, 129, 0.3)');
            } else if (theme === 'blue') {
                root.style.setProperty('--theme-color', '#3b82f6');
                root.style.setProperty('--theme-hover', '#2563eb');
                root.style.setProperty('--theme-light', 'rgba(59, 130, 246, 0.15)');
                root.style.setProperty('--theme-border', 'rgba(59, 130, 246, 0.3)');
            } else if (theme === 'orange') {
                root.style.setProperty('--theme-color', '#f97316');
                root.style.setProperty('--theme-hover', '#ea580c');
                root.style.setProperty('--theme-light', 'rgba(249, 115, 22, 0.15)');
                root.style.setProperty('--theme-border', 'rgba(249, 115, 22, 0.3)');
            } else if (theme === 'purple') {
                root.style.setProperty('--theme-color', '#a855f7');
                root.style.setProperty('--theme-hover', '#9333ea');
                root.style.setProperty('--theme-light', 'rgba(168, 85, 247, 0.15)');
                root.style.setProperty('--theme-border', 'rgba(168, 85, 247, 0.3)');
            } else if (theme === 'pink') {
                root.style.setProperty('--theme-color', '#ec4899');
                root.style.setProperty('--theme-hover', '#db2777');
                root.style.setProperty('--theme-light', 'rgba(236, 72, 153, 0.15)');
                root.style.setProperty('--theme-border', 'rgba(236, 72, 153, 0.3)');
            }
            document.getElementById('themeDropdown').classList.add('hidden');
        }

        // --- 4. Interactive Simulator Logic ---
        function handleAddFood(e) {
            e.preventDefault();
            const nameInput = document.getElementById('foodName');
            const dateInput = document.getElementById('expiryDate');

            if (!nameInput.value || !dateInput.value) return;

            const newItem = {
                id: Date.now(),
                name: nameInput.value,
                date: dateInput.value
            };

            foodItems.unshift(newItem);
            nameInput.value = '';
            renderFoodList();
        }

        function deleteFood(id) {
            foodItems = foodItems.filter(item => item.id !== id);
            renderFoodList();
        }

        function calculateDDay(targetDateStr) {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const target = new Date(targetDateStr);
            target.setHours(0, 0, 0, 0);

            const diffTime = target - today;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            return diffDays;
        }

        function renderFoodList() {
            const container = document.getElementById('foodList');
            const lang = i18n[currentLang];
            container.innerHTML = '';

            if (foodItems.length === 0) {
                container.innerHTML = `<div class="text-center py-6 text-gray-500 text-sm">등록된 식재료가 없습니다.</div>`;
                return;
            }

            foodItems.forEach(item => {
                const diffDays = calculateDDay(item.date);
                let badgeClass = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
                let badgeText = `D-${diffDays} ${lang.dDayTag}`;

                if (diffDays < 0) {
                    badgeClass = 'bg-rose-500/10 text-rose-400 border-rose-500/20';
                    badgeText = `${lang.expiredTag} (${Math.abs(diffDays)}d)`;
                } else if (diffDays === 0) {
                    badgeClass = 'bg-amber-500/10 text-amber-400 border-amber-500/20';
                    badgeText = lang.todayTag;
                } else if (diffDays <= 3) {
                    badgeClass = 'bg-amber-500/10 text-amber-400 border-amber-500/20';
                }

                const itemEl = document.createElement('div');
                itemEl.className = 'bg-gray-950 border border-gray-800 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:border-gray-700 transition-all';
                itemEl.innerHTML = `
                    <div class="space-y-1">
                        <div class="flex items-center gap-2.5">
                            <span class="font-bold text-white text-base">${item.name}</span>
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold border ${badgeClass}">
                                ${badgeText}
                            </span>
                        </div>
                        <div class="text-xs text-gray-400 flex items-center gap-1.5 pt-0.5">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 theme-text"></i>
                            <span>${lang.aiPrefix}<strong>${item.name}</strong>${lang.aiSuffix}</span>
                        </div>
                    </div>
                    <div class="flex items-center justify-between sm:justify-end gap-3 border-t sm:border-t-0 border-gray-900 pt-2 sm:pt-0">
                        <span class="text-xs text-gray-500">${item.date}</span>
                        <button onclick="deleteFood(${item.id})" class="text-gray-500 hover:text-rose-400 p-1 rounded-lg transition-colors">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                `;
                container.appendChild(itemEl);
            });

            lucide.createIcons();
        }

        // Initialize App
        lucide.createIcons();
        renderFoodList();
    </script>
</body>
