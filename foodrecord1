<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foodrecord - 식재료 유통기한 관리 & AI 레시피</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700&display=swap');
        
        * {
            font-family: 'Pretendard', sans-serif;
        }

        /* 다크 테마 날짜 입력창 스타일 보정 */
        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
            opacity: 0.8;
        }
        input[type="date"]::-webkit-calendar-picker-indicator:hover {
            opacity: 1;
        }

        /* 테마 색상 변수 정의 */
        :root {
            --theme-color: #10b981;
            --theme-hover: #059669;
            --theme-light: rgba(16, 185, 129, 0.15);
            --theme-border: rgba(16, 185, 129, 0.3);
        }

        .theme-bg { background-color: var(--theme-color) !important; }
        .theme-bg-hover:hover { background-color: var(--theme-hover) !important; }
        .theme-text { color: var(--theme-color) !important; }
        .theme-border { border-color: var(--theme-border) !important; }
        .theme-light-bg { background-color: var(--theme-light) !important; }

        /* 커스텀 스크롤바 */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #111827;
        }
        ::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4b5563;
        }
    </style>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen flex flex-col selection:bg-emerald-500 selection:text-white">

    <!-- 1. Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-gray-950/80 border-b border-gray-800">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            
            <!-- Logo -->
            <div class="flex items-center gap-3 cursor-pointer">
                <!-- SVG 로고 (음식 + 재생 + 캘린더 모티브) -->
                <div class="w-10 h-10 rounded-xl theme-light-bg flex items-center justify-center border theme-border">
                    <svg class="w-6 h-6 theme-text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a8 8 0 0 0-8 8v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a8 8 0 0 0-8-8z"></path>
                        <polygon points="10 9 15 12 10 15 10 9" fill="currentColor"></polygon>
                        <rect x="14" y="14" width="4" height="4" rx="1"></rect>
                    </svg>
                </div>
                <span class="font-bold text-xl tracking-tight text-white">FOOD<span class="theme-text">RECORD</span></span>
            </div>

            <!-- Controls (Language & Theme Buttons) -->
            <div class="flex items-center gap-3">
                <!-- Language Selector -->
                <div class="relative">
                    <button id="langBtn" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gray-900 border border-gray-800 hover:border-gray-700 text-sm font-medium transition-all text-gray-300">
                        <i data-lucide="globe" class="w-4 h-4 theme-text"></i>
                        <span id="currentLangText">🌐 Language</span>
                        <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-gray-500"></i>
                    </button>
                    <div id="langDropdown" class="hidden absolute right-0 mt-2 w-40 bg-gray-900 border border-gray-800 rounded-xl shadow-2xl py-2 z-50">
                        <button onclick="changeLanguage('ko')" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-800 flex items-center gap-2">🇰🇷 한국어</button>
                        <button onclick="changeLanguage('en')" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-800 flex items-center gap-2">🇺🇸 English</button>
                        <button onclick="changeLanguage('ja')" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-800 flex items-center gap-2">🇯🇵 日本語</button>
                        <button onclick="changeLanguage('zh')" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-800 flex items-center gap-2">🇨🇳 中文 (简体)</button>
                        <button onclick="changeLanguage('es')" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-800 flex items-center gap-2">🇪🇸 Español</button>
                        <button onclick="changeLanguage('fr')" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-800 flex items-center gap-2">🇫🇷 Français</button>
                        <button onclick="changeLanguage('de')" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-800 flex items-center gap-2">🇩🇪 Deutsch</button>
                        <button onclick="changeLanguage('vi')" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-800 flex items-center gap-2">🇻🇳 Tiếng Việt</button>
